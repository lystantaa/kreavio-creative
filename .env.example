# =====================================================================
# KREAVIO CREATIVE - ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env jika ingin mengubah konfigurasi default
# =====================================================================

# Konfigurasi Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kreavio_db
DB_USER=root
DB_PASS=

# Konfigurasi Midtrans Sandbox (Testing Payment Gateway)
# Kosongkan jika ingin menggunakan Demo Payment Mode
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Opsional: Override Base URL jika diperlukan (contoh: http://localhost/kreavio/)
# APP_URL=http://localhost/kreavio/
